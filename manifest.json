{
  "manifest_version": 3,
  "name": "Inkline",
  "version": "1.0.0",
  "description": "Records a lightweight version history of your writing and plays it back as a timelapse. Everything stays on your device.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Inkline",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://docs.google.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": [
        "src/shared/ops.js",
        "src/shared/diff.js",
        "src/shared/reconcile.js",
        "src/content/client.js",
        "src/content/indicator.js",
        "src/content/docs.config.js",
        "src/content/docs.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
